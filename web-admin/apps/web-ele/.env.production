VITE_BASE=/

# 接口地址：生产后端 context-path 已改为根路径 /，nginx 域名根反代 → 8091；如前后端不同域，改为完整地址 http://host:port
VITE_GLOB_API_URL=/

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
