VITE_BASE=/

# 接口地址：生产 API 独立域名（nginx 域名根反代 → 8091，后端 context-path 为根路径 /，无 /api 前缀）
VITE_GLOB_API_URL=https://oa-api.easykits.cn

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
